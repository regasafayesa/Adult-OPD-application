import { readFileSync, writeFileSync } from 'node:fs';
import { runInNewContext } from 'node:vm';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const facilityId = process.argv[2];
const outputPath = process.argv[3];

if (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(facilityId || '')) {
  throw new Error('Usage: node scripts/generate-esv1-catalog-import.mjs <facility-uuid> <output.sql>');
}
if (!outputPath) {
  throw new Error('Provide an output SQL file path.');
}

const sourcePath = fileURLToPath(new URL('../services/esv1Diagnoses.js', import.meta.url));
const source = readFileSync(sourcePath, 'utf8');
const entriesMatch = source.match(/const ESV1_ENTRIES = (\[[\s\S]*?\n\]);/);
if (!entriesMatch) {
  throw new Error('Could not find the ESV-1 diagnosis entries in services/esv1Diagnoses.js.');
}

const sourceEntries = runInNewContext(entriesMatch[1]);
const diagnoses = sourceEntries
  .filter((entry) => Array.isArray(entry) && entry.length === 2 && entry.every((value) => typeof value === 'string'))
  .map(([code, name]) => ({ id: `esv1-${code}`, code, name }));

if (diagnoses.length !== 219 || new Set(diagnoses.map(({ code }) => code)).size !== diagnoses.length) {
  throw new Error(`Expected 219 ESV-1 entries with unique codes; found ${diagnoses.length}.`);
}

function sqlString(value) {
  return `'${String(value).replace(/'/g, "''")}'`;
}

const values = diagnoses
  .map(({ id, code, name }) => `      (${sqlString(id)}, ${sqlString(code)}, ${sqlString(name)})`)
  .join(',\n');
const sql = `begin;

do $$
declare
  target_facility uuid := '${facilityId}';
  conflicting_entries integer;
begin
  if not exists (
    select 1 from public.facilities where id = target_facility
  ) then
    raise exception 'Facility % does not exist', target_facility;
  end if;

  select count(*)
    into conflicting_entries
  from (values
${values}
  ) as esv(id, code, name)
  join public.diagnoses existing
    on existing.facility_id = target_facility
   and (
     existing.id = esv.id
     or existing.code = esv.code
     or lower(existing.name) = lower(esv.name)
   )
  where not (
    existing.code = esv.code
    and existing.name = esv.name
    and existing.active
    and existing.official
  );

  if conflicting_entries > 0 then
    raise exception 'Found % conflicting diagnosis entries for facility %; no catalog rows were inserted',
      conflicting_entries, target_facility;
  end if;

  insert into public.diagnoses (facility_id, id, code, name, active, official)
  select target_facility, esv.id, esv.code, esv.name, true, true
  from (values
${values}
  ) as esv(id, code, name)
  where not exists (
    select 1
    from public.diagnoses existing
    where existing.facility_id = target_facility
      and (
        existing.id = esv.id
        or existing.code = esv.code
        or lower(existing.name) = lower(esv.name)
      )
  );
end
$$;

commit;
`;

const resolvedOutputPath = resolve(outputPath);
writeFileSync(resolvedOutputPath, sql, 'utf8');
console.log(`Generated ${diagnoses.length} ESV-1 catalog entries for facility ${facilityId}: ${resolvedOutputPath}`);
